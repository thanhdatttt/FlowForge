# Local development only. Copy to .env and choose a password before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
API_PORT=8080
JWT_SIGNING_KEY=replace-with-your-key

# Gmail SMTP. Keep blank until you configure a Gmail App Password.
SMTP_USERNAME=
SMTP_APP_PASSWORD=
EMAIL_VERIFICATION_LIFETIME_MINUTES=10
INVITATION_LIFETIME_DAYS=7
PUBLIC_API_URL=http://localhost:8080

# Background processing. Email is queued only when SMTP is configured.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_POLL_SECONDS=5
NOTIFICATIONS_OVERDUE_INTERVAL_MINUTES=5
