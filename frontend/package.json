{
  "name": "flowforge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --import ./tests/register.mjs --test --test-isolation=none tests/*.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test:live": "node --import ./tests/register.mjs tests/live-backend.ts",
    "test:phase3:live": "node --import ./tests/register.mjs tests/phase3-live.ts",
    "test:phase4:live": "node --import ./tests/register.mjs tests/phase4-live.ts",
    "test:phase5:live": "node --import ./tests/register.mjs tests/phase5-live.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
